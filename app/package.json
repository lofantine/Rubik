{
  "name": "app",
  "version": "1.0.0",
  "description": "",
  "main": "build/index.js",
  "scripts": {
    "build": "rm -rf build && tsc && bun build src/renderer/main.tsx --outdir build/renderer --target browser --minify && tailwindcss -i src/renderer/index.css -o build/renderer/index.css --minify && cp src/renderer/index.html build/renderer/",
    "typecheck": "tsc --noEmit && tsc -p src/renderer",
    "start": "bun run build && electron ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "^1.4.2",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "electron": "^44.5.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "three": "^0.186.1",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "tailwindcss": "^4.3.3"
  }
}
